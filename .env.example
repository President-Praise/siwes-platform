# Environment variables for siwes-platform
# Copy this file to `.env` and fill in real values.
# See SECRETS.md for where to get each one.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Anthropic (Claude) ---
CLAUDE_MODEL=
REPORT_USE_CLAUDE=

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- self-generated ---
SECRET_KEY=

# --- self-set admin cred ---
LMU_ADMIN_INITIAL_PIN=
SUPER_ADMIN_INITIAL_PIN=

# --- unknown ---
COOKIE_SECURE=
PLATFORM_CUT_PCT=
PLATFORM_NAME=
SOFFICE_BIN=

# --- your site URL ---
PUBLIC_BASE_URL=
