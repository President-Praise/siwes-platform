# ---- Platform ----
ANTHROPIC_API_KEY=
REPORT_USE_CLAUDE=1
CLAUDE_MODEL=claude-sonnet-4-6
SECRET_KEY=                          # for signing — generate with: openssl rand -hex 32

# ---- Default Paystack (used if school doesn't have their own keys) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Super admin initial PIN (hashed and inserted on first run if super_admin is empty) ----
SUPER_ADMIN_INITIAL_PIN=

# ---- Platform settings ----
PLATFORM_NAME=SIWES Report Platform
PLATFORM_CUT_PCT=20

# ---- Behaviour ----
PUBLIC_BASE_URL=                     # e.g. https://siwes.example.com — leave blank for local dev
COOKIE_SECURE=0                      # set to 1 in production (HTTPS)
